# Phoenix-Logs-RMQ configuration template.
#
#   cp .env.example .env
#
# The values below match the local stack in docker-compose.yaml, so
# `docker compose up rabbitmq clickhouse` + `make run` works out of the box.
# Defaults live in internal/config/config.go. RB_HOST, RB_USERNAME,
# RB_PASSWD, CLICK_HOUSE_HOST and CLICK_HOUSE_PASSWORD are required.
# Never commit your real .env.

# --- RabbitMQ connection ---
RB_HOST=localhost
RB_PORT=5672
RB_VHOST=/
RB_USERNAME=phoenix
RB_PASSWD=phoenix

# --- Consumer ---
RB_CONSUME_QUEUE=v3_logs
RB_CONSUMER_TAG=phoenix-logs-rmq-1
# Each handler waits for its batch to be inserted, so keep RB_WORKER_COUNT
# and RB_PREFETCH >= 2 x BATCH_SIZE (the default when left unset).
RB_WORKER_COUNT=1000
RB_PREFETCH=1000
AMQPR_CON_DELAY=5s
# Must be greater than BATCH_FLUSH_INTERVAL + CLICK_HOUSE_INSERT_TIMEOUT.
RB_PROCESS_TIMEOUT=30s

# --- Message types ---
# Values of the AMQP "type" header (case-insensitive). A message without the
# header is treated as MSG_TYPE_MAIL_FLOW. The two must differ.
MSG_TYPE_AUDIT=audit
MSG_TYPE_MAIL_FLOW=fuglu

# --- Batching ---
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL=2s

# --- ClickHouse ---
CLICK_HOUSE_HOST=localhost
# 8123 = HTTP (CLICK_HOUSE_HTTP=true), 9000 = native (CLICK_HOUSE_HTTP=false)
CLICK_HOUSE_PORT=8123
CLICK_HOUSE_HTTP=true
CLICK_HOUSE_USERNAME=default
CLICK_HOUSE_PASSWORD=changeme
CLICK_HOUSE_DATABASE=default
CLICK_HOUSE_AUDIT_LOGS_TABLE=audit_logs
CLICK_HOUSE_MAIL_FLOW_LOGS_TABLE=mail_flow_logs
CLICK_HOUSE_INSERT_TIMEOUT=15s

# --- Logging ---
LOG_FILE=./logs/app.log
LOG_MAX_SIZE_MB=50
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=14
LOG_COMPRESS=true
LOG_LEVEL=debug
LOG_CONSOLE=true
